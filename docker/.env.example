## SEDI Tablette - docker/.env.example
## Copie ce fichier en `docker/.env` (ce fichier est ignoré par git).
## Ne commit jamais de secrets.

## Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

## Backend DB (SEDI_APP_INDEPENDANTE)
## Login SQL métier (pas un secret). Mot de passe UNIQUEMENT dans docker/.env (jamais commit).
DB_DATABASE=SEDI_APP_INDEPENDANTE
DB_USER=QUALITE
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

## ERP DB (SEDI_ERP)
DB_ERP_SERVER=SERVEURERP
DB_ERP_DATABASE=SEDI_ERP
DB_ERP_USER=QUALITE
DB_ERP_PASSWORD=
DB_ERP_ENCRYPT=false
DB_ERP_TRUST_CERT=true

## Secrets (change en prod)
JWT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME

## Grafana
GRAFANA_ADMIN_USER=grafana-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_SECRET_KEY=CHANGE_ME
GRAFANA_ROOT_URL=http://127.0.0.1:3002/

## Mounts
SERVICES_HOST_PATH=/mnt/partage_fsop
SERVICES_CONTAINER_PATH=/mnt/services
TEMPLATES_HOST_PATH=/mnt/templates
TEMPLATES_CONTAINER_PATH=/mnt/templates

## HTTPS local (certificat auto-signé pour scan caméra sur tablettes)
# IP réelle de la VM (ex: 192.168.1.26)
SSL_EXTRA_IP=
# Régénération : cd docker && ./scripts/regenerate-fsop-ssl.sh

## HTTPS public Let's Encrypt (fsop.sedi-ati.com, reconnu par tous les navigateurs)
# Jeton d'accès personnel Gandi avec le droit "Gérer la configuration DNS" sur sedi-ati.com
GANDI_LIVEDNS_TOKEN=
LETSENCRYPT_EMAIL=
# Émission : cd docker && ./scripts/letsencrypt-fsop.sh
# Renouvellement auto : sudo ./scripts/letsencrypt-fsop.sh install-timer
