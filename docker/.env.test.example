# Copier vers docker/.env.test sur l'hôte TEST (jamais la prod)
#   cp .env.test.example .env.test

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-test
JWT_SECRET=change-me-jwt-test-secret-min-32-chars

DB_SERVER=SERVEURERP
DB_SERVER_IP=192.168.1.10
DB_DATABASE=SEDI_APP_INDEPENDANTE
DB_USER=QUALITE
DB_PASSWORD=

# ERP de test (pas SEDI_ERP prod)
DB_ERP_DATABASE=SEDI_TESTS
DB_ERP_USER=QUALITE
DB_ERP_PASSWORD=

SILOG_REMOTE_MODE=scheduled
SILOG_DB=SEDI_TESTS
ENABLE_AUTO_VALIDATE_TEMPS=false
ENABLE_FACTORIAL_AUTOCLOSE=false
ALERTS_ENABLED=false

TEST_HTTP_PORT=8088
TEST_HTTPS_PORT=8444

# Montages (adapter au serveur test)
SERVICES_HOST_PATH=/srv/services
TEMPLATES_HOST_PATH=/srv/services
FSOP_TEMPLATES_DIR=
FSOP_TEMPLATES_XLSX_PATH=
