# Copier vers backend/.env pour le DEV RH (ou fusionner les clés).
# Ne PAS utiliser SEDI_APP_INDEPENDANTE pour écrire des corrections RH.

NODE_ENV=development
DB_DATABASE=SEDI_APP_DEV

# Même serveur SQL que d'habitude, autre base :
# DB_SERVER=...
# DB_USER=QUALITE
# DB_PASSWORD=...

# Jamais true en DEV sauf besoin exceptionnel et assumé
ALLOW_RH_WRITES_ON_SHARED_DB=false

# Préparer la base :
#   node scripts/ensure-dev-database.js --seed-days=14
