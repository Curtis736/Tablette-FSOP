{
  "name": "sedi-tablette-backend",
  "version": "1.0.0",
  "description": "Backend API pour l'interface tablette SEDI ERP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:email": "node test-email-simple.js",
    "test": "node tests/native-tests.js",
    "test:complete": "node tests/complete-tests.js",
    "test:all": "npm run test && npm run test:complete",
    "test:vitest": "vitest",
    "test:vitest:run": "vitest run",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:coverage": "vitest run --coverage",
    "test:vitest:watch": "vitest --watch",
    "test:ci": "vitest run --reporter=verbose --coverage",
    "test:coverage": "vitest run --config vitest.config.mjs --coverage",
    "test:integration": "vitest run --config vitest.config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --format json --output-file eslint-report.json",
    "test:security": "node scripts/security-test.js || echo 'Security tests skipped (server not running)'",
    "test:health": "node scripts/health-check.js || echo 'Health check skipped (server not running)'",
    "watchdog": "node scripts/proactive-watchdog.js",
    "sonar": "sonar-scanner",
    "quality": "npm run lint:report && npm run sonar",
    "test:full": "npm run test:all && npm run quality"
  },
  "keywords": [
    "sedi",
    "erp",
    "tablette",
    "api"
  ],
  "author": "SEDI",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "fast-xml-parser": "^5.7.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.8",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "mssql": "^12.7.5",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.1.0",
    "prom-client": "^15.1.0",
    "redis": "^4.6.12",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.14",
    "vitest": "4.1.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.12",
    "braces": "^3.0.3",
    "chokidar": "^4.0.3",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "sprintf-js": "^1.1.3",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@vitest/mocker": "4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
