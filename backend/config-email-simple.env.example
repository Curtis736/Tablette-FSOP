# Copier vers config-email-simple.env (non versionné) :
#   cp config-email-simple.env.example config-email-simple.env
#
# Configuration locale pour les commentaires / email (dev).

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:8080

DB_SERVER=SERVEURERP
DB_DATABASE=SEDI_APP_INDEPENDANTE
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_ENCRYPT=false
DB_TRUST_CERT=true

EMAIL_DISABLED=false
EMAIL_USE_HTTP=true
EMAIL_FALLBACK_SERVICE=formspree
FORMSPREE_URL=https://formspree.io/f/your-form-id
