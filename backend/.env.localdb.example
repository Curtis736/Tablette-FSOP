DB_SANDBOX=true
NODE_ENV=development

DB_SERVER=127.0.0.1
DB_PORT=14330
DB_DATABASE=SEDI_APP_INDEPENDANTE
DB_USER=sa
DB_PASSWORD=Sedi_Local_Test_2026!
DB_ENCRYPT=false
DB_TRUST_CERT=true

DB_ERP_SERVER=127.0.0.1
DB_ERP_PORT=14330
DB_ERP_DATABASE=SEDI_ERP
DB_ERP_USER=sa
DB_ERP_PASSWORD=Sedi_Local_Test_2026!

JWT_SECRET=sandbox-local-jwt-secret-not-for-prod-32chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ENABLE_RH=true
RH_USERNAME=rh
RH_PASSWORD=rh

# Aucune sortie vers l'extÃ©rieur
SILOG_REMOTE_MODE=scheduled
SILOG_SSH_HOST=
ENABLE_FACTORIAL_AUTOCLOSE=false
FACTORIAL_API_TOKEN=
EMAIL_DISABLED=true
ALERTS_ENABLED=false
TEAMS_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
TRACEABILITY_DIR=

DISABLE_STARTUP_CLEANUP=true
ENABLE_PERIODIC_CLEANUP=false
ENABLE_AUTO_CLOSE_OPS=true
ENABLE_AUTO_VALIDATE_TEMPS=true
OPERATOR_HISTORY_DAYS=30
