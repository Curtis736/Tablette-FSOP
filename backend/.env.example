## SILOG EDI_JOB
# scheduled = la tâche planifiée sur SVC_SILOG déclenche SEDI_ETDIFF (recommandé)
# ssh = le backend déclenche SILOG.exe via SSH
# (vide) = le backend déclenche SILOG.exe localement (Windows uniquement)
SILOG_REMOTE_MODE=scheduled

## Clôture automatique des opérations restées ouvertes (FIN auto, RequestId auto_close_ops_AAAAMMJJ)
# Rattrape aussi les N jours précédents (opérations oubliées / FIN perdue).
ENABLE_AUTO_CLOSE_OPS=true
AUTO_CLOSE_OPS_HOUR=20
AUTO_CLOSE_OPS_LOOKBACK_DAYS=7

# Validation immédiate à la FIN opérateur — désactivé par défaut (risque doublons SILOG).
# La validation passe par le bouton Transfert admin (NULL → O) + SEDI_ETDIFF en continu sur SVC_SILOG.
AUTO_VALIDATE_ON_FIN=false
# Historique visible côté opérateur (tablette), en nombre de jours.
# 1 = uniquement aujourd'hui (évite d'afficher la veille après transfert).
OPERATOR_HISTORY_DAYS=1

# Rétention affichage admin des lignes déjà transmises (StatutTraitement=T) : gérée côté frontend
# (TRANSMITTED_VISIBLE_DAYS dans frontend/utils/Constants.js). L’API opérateur exclut toujours les T.

## Watchdog pipeline SILOG
# Seuil en heures : si des enregistrements 'O' ne passent pas 'T' après ce délai,
# l'endpoint /api/admin/silog-pipeline-status signale un WARNING.
# Les O sur lancements soldés (LCTE.LancementSolde <> N) sont exclus de l'alerte critique.
SILOG_STALE_THRESHOLD_HOURS=24

## Alertes fiabilité (Teams + email)
ALERTS_ENABLED=true
ALERT_COOLDOWN_MINUTES=60
ALERT_EMAIL=kumbi.c@sedi-ati.com
# Incoming webhook Teams (MessageCard)
TEAMS_WEBHOOK_URL=
# Alias accepté
# ALERT_TEAMS_WEBHOOK=

## Limites mémoire Docker (docker-compose.production.yml)
# BACKEND_MEM_LIMIT=1536m
# FRONTEND_MEM_LIMIT=256m
# REDIS_MEM_LIMIT=384m
